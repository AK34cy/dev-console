#!/usr/bin/env bash
set -euo pipefail

PROFILE_PATH="/etc/apparmor.d/iovon-dev-console-codex-bwrap"
PROFILE_NAME="iovon-dev-console-codex-bwrap"
SERVICE_USER=""
REQUIRE_BWRAP=0

log() {
  printf '[codex-apparmor] %s\n' "$*"
}

fail() {
  printf '[codex-apparmor] ERROR: %s\n' "$*" >&2
  exit 1
}

usage() {
  cat <<'USAGE'
Usage:
  configure-codex-apparmor --user <service-user> [--require-bwrap]

Options:
  --user           Existing Linux account that runs Dev Console.
  --require-bwrap  Fail if the Codex standalone bundled bwrap is not present.
USAGE
}

while (($# > 0)); do
  case "$1" in
    --user)
      [[ $# -ge 2 ]] || fail "--user requires a value."
      SERVICE_USER="$2"
      shift 2
      ;;
    --require-bwrap)
      REQUIRE_BWRAP=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      fail "Unknown argument: $1"
      ;;
  esac
done

[[ "${EUID}" -eq 0 ]] || fail "Run as root or through sudo -n."
[[ -n "$SERVICE_USER" ]] || fail "--user is required."
id "$SERVICE_USER" >/dev/null 2>&1 || fail "Linux user does not exist: $SERVICE_USER"

if [[ ! -r /sys/module/apparmor/parameters/enabled ]] || ! grep -qi '^Y' /sys/module/apparmor/parameters/enabled; then
  log "AppArmor is not enabled; Codex AppArmor profile was not configured."
  exit 0
fi

restriction="$(sysctl -n kernel.apparmor_restrict_unprivileged_userns 2>/dev/null || printf '0')"
if [[ "$restriction" != "1" ]]; then
  log "kernel.apparmor_restrict_unprivileged_userns is $restriction; Codex AppArmor profile is not required."
  exit 0
fi

SERVICE_HOME="$(getent passwd "$SERVICE_USER" | cut -d: -f6)"
[[ -n "$SERVICE_HOME" && "$SERVICE_HOME" = /* ]] || fail "Could not resolve home directory for $SERVICE_USER."
case "$SERVICE_HOME" in
  *[[:space:]\{\}\",]*)
    fail "Unsupported service user home path for AppArmor profile: $SERVICE_HOME"
    ;;
esac

mapfile -d '' BWRAP_PATHS < <(find "$SERVICE_HOME/.codex/packages/standalone/releases" \
  -mindepth 3 -maxdepth 3 \
  -path '*/codex-resources/bwrap' \
  -type f -executable -print0 2>/dev/null || true)

if ((${#BWRAP_PATHS[@]} == 0)); then
  if [[ "$REQUIRE_BWRAP" -eq 1 ]]; then
    fail "Codex standalone bundled bwrap was not found under $SERVICE_HOME/.codex/packages/standalone/releases."
  fi
  log "Codex standalone bundled bwrap was not found; Codex AppArmor profile was not configured."
  exit 0
fi

command -v apparmor_parser >/dev/null 2>&1 || fail "apparmor_parser is required but not installed."

tmp_profile="$(mktemp)"
cleanup() {
  rm -f "$tmp_profile"
}
trap cleanup EXIT

cat > "$tmp_profile" <<PROFILE
# Managed by IOVON Dev Console. Do not edit this file directly.
abi <abi/4.0>,
include <tunables/global>

profile $PROFILE_NAME $SERVICE_HOME/.codex/packages/standalone/releases/*/codex-resources/bwrap flags=(unconfined) {
  userns,

  include if exists <local/$PROFILE_NAME>
}
PROFILE

apparmor_parser -Q -T "$tmp_profile" >/dev/null

if [[ -f "$PROFILE_PATH" ]] && cmp -s "$tmp_profile" "$PROFILE_PATH"; then
  log "Codex AppArmor profile is already current: $PROFILE_PATH"
else
  install -o root -g root -m 0644 "$tmp_profile" "$PROFILE_PATH"
  log "Installed Codex AppArmor profile: $PROFILE_PATH"
fi

apparmor_parser -r -T "$PROFILE_PATH" >/dev/null
log "Reloaded Codex AppArmor profile."

restriction_after="$(sysctl -n kernel.apparmor_restrict_unprivileged_userns 2>/dev/null || printf 'unknown')"
if [[ "$restriction_after" != "1" ]]; then
  fail "Unexpected kernel.apparmor_restrict_unprivileged_userns value after profile load: $restriction_after"
fi

log "Global unprivileged user namespace restriction remains enabled."
log "Profile attachment: $SERVICE_HOME/.codex/packages/standalone/releases/*/codex-resources/bwrap"
